{
  "name": "@shipvo/sim",
  "version": "0.1.5",
  "type": "module",
  "license": "Apache-2.0",
  "description": "The Shipvo simulator: runs a Shipvo app's web build in a phone-sized headless browser and exposes it to agents (accessibility tree, tap/type/scroll, simulated device, mock backend). Used by @shipvo/mcp and `shipvo sim`.",
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "shipvo-sim": "server.mjs"
  },
  "exports": {
    "./server.mjs": "./server.mjs",
    "./screen-rules.mjs": "./screen-rules.mjs",
    "./frame.mjs": {
      "types": "./frame.d.mts",
      "default": "./frame.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "server.mjs",
    "chromium-hint.mjs",
    "browser-resolver.mjs",
    "app-name.mjs",
    "frame.mjs",
    "lumi.mjs",
    "phone-browser.mjs",
    "browser-app.mjs",
    "ws-lite.mjs",
    "lifecycle.mjs",
    "shade.mjs",
    "shade-actions.mjs",
    "settings.mjs",
    "settings-actions.mjs",
    "nav.mjs",
    "update.mjs",
    "frame.d.mts",
    "mock-rules.mjs",
    "screen-rules.mjs",
    "push-notification.mjs",
    "network-profiles.mjs",
    "apps.mjs",
    "README.md"
  ],
  "peerDependencies": {
    "playwright": ">=1.50"
  },
  "keywords": [
    "shipvo",
    "react-native",
    "react-native-web",
    "mobile-simulator",
    "headless",
    "playwright",
    "mcp",
    "ai-agents",
    "mobile-testing",
    "e2e-testing"
  ],
  "homepage": "https://github.com/shipvo/shipvo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipvo/shipvo.git",
    "directory": "packages/sim"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
