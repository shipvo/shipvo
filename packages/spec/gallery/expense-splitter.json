{
  "spec": "shipvo.app/v0",
  "app": {
    "id": "expense-splitter",
    "name": "Expense splitter",
    "description": "Add shared expenses and see who paid how much."
  },
  "theme": {
    "mode": "light",
    "palette": {
      "primary": "#0B5FFF",
      "text": "#111827",
      "background": "#FFFFFF",
      "surface": "#F3F4F6",
      "muted": "#4B5563"
    },
    "radius": "lg",
    "density": "comfortable"
  },
  "data": {
    "expenses": {
      "source": "collection",
      "fields": {
        "payer": "text",
        "what": "text",
        "amount": "number"
      },
      "seed": []
    },
    "total": {
      "source": "computed",
      "value": "{{ sum(expenses.map(e, e.amount)) }}"
    },
    "perPerson": {
      "source": "computed",
      "value": "{{ count(unique(expenses.map(e, e.payer))) == 0 ? 0 : sum(expenses.map(e, e.amount)) / count(unique(expenses.map(e, e.payer))) }}"
    }
  },
  "screens": [
    {
      "id": "home",
      "title": "Expenses",
      "body": [
        {
          "type": "text",
          "variant": "title",
          "value": "Total {{ money(total, 'USD') }}"
        },
        {
          "type": "badge",
          "value": "Each pays {{ money(perPerson, 'USD') }}"
        },
        {
          "type": "chart",
          "kind": "donut",
          "from": "expenses",
          "x": "{{ item.payer }}",
          "y": "{{ item.amount }}",
          "aggregate": "sum",
          "label": "Paid by person"
        },
        {
          "type": "form",
          "label": "Add expense form",
          "submit": {
            "label": "Add expense",
            "action": "add_expense"
          },
          "fields": [
            {
              "name": "payer",
              "type": "text",
              "label": "Paid by",
              "required": true,
              "maxLength": 60
            },
            {
              "name": "what",
              "type": "text",
              "label": "For",
              "required": true,
              "maxLength": 100
            },
            {
              "name": "amount",
              "type": "number",
              "label": "Amount",
              "required": true,
              "min": 0
            }
          ]
        },
        {
          "type": "list",
          "label": "Expenses",
          "from": "{{ expenses }}",
          "item": {
            "title": "{{ item.what }}",
            "subtitle": "{{ item.payer }}, {{ money(item.amount, 'USD') }}"
          },
          "empty": {
            "message": "No expenses yet"
          }
        }
      ]
    }
  ],
  "actions": {
    "add_expense": {
      "description": "Add an expense that one person paid.",
      "input": {
        "payer": {
          "type": "text"
        },
        "what": {
          "type": "text"
        },
        "amount": {
          "type": "number"
        }
      },
      "do": [
        {
          "insert": "expenses",
          "value": {
            "payer": "{{ input.payer }}",
            "what": "{{ input.what }}",
            "amount": "{{ input.amount }}"
          }
        },
        {
          "toast": "Expense added"
        }
      ]
    }
  }
}
