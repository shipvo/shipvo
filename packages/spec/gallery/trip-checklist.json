{
  "spec": "shipvo.app/v0",
  "app": {
    "id": "trip-checklist",
    "name": "Trip checklist",
    "description": "Pack for a trip and tick items off."
  },
  "theme": {
    "mode": "light",
    "palette": {
      "primary": "#0B5FFF",
      "text": "#111827",
      "background": "#FFFFFF",
      "surface": "#F3F4F6",
      "muted": "#4B5563"
    },
    "radius": "lg",
    "density": "comfortable"
  },
  "data": {
    "items": {
      "source": "collection",
      "fields": {
        "name": "text",
        "group": "text",
        "packed": "bool"
      },
      "seed": []
    },
    "left": {
      "source": "computed",
      "value": "{{ items.filter(i, !i.packed) }}"
    },
    "packedCount": {
      "source": "computed",
      "value": "{{ count(items.filter(i, i.packed)) }}"
    }
  },
  "screens": [
    {
      "id": "home",
      "title": "Packing",
      "body": [
        {
          "type": "text",
          "variant": "title",
          "value": "{{ packedCount }} of {{ count(items) }} packed"
        },
        {
          "type": "chart",
          "kind": "bar",
          "from": "items",
          "x": "{{ item.group }}",
          "y": "{{ 1 }}",
          "aggregate": "count",
          "label": "Items by group"
        },
        {
          "type": "form",
          "label": "Add item form",
          "submit": {
            "label": "Add item",
            "action": "add_item"
          },
          "fields": [
            {
              "name": "name",
              "type": "text",
              "label": "Item",
              "required": true,
              "maxLength": 100
            },
            {
              "name": "group",
              "type": "text",
              "label": "Group",
              "maxLength": 40
            }
          ]
        },
        {
          "type": "form",
          "label": "Pack item form",
          "submit": {
            "label": "Pack item",
            "action": "pack_item"
          },
          "fields": [
            {
              "name": "name",
              "type": "text",
              "label": "Item to tick off",
              "required": true,
              "maxLength": 200
            }
          ]
        },
        {
          "type": "list",
          "label": "Still to pack",
          "from": "{{ sortBy(left, 'group') }}",
          "item": {
            "title": "{{ item.name }}",
            "subtitle": "{{ item.group }}"
          },
          "empty": {
            "message": "Everything is packed"
          }
        }
      ]
    }
  ],
  "actions": {
    "add_item": {
      "description": "Add an item to pack.",
      "input": {
        "name": {
          "type": "text"
        },
        "group": {
          "type": "text",
          "default": "General"
        }
      },
      "do": [
        {
          "insert": "items",
          "value": {
            "name": "{{ input.name }}",
            "group": "{{ input.group == '' ? 'General' : input.group }}",
            "packed": false
          }
        },
        {
          "toast": "Item added"
        }
      ]
    },
    "pack_item": {
      "description": "Tick off the item with this name as packed.",
      "input": {
        "name": {
          "type": "text"
        }
      },
      "do": [
        {
          "update": "items",
          "where": "item.name == input.name",
          "value": {
            "packed": true
          }
        },
        {
          "toast": "Item packed"
        }
      ]
    }
  }
}
