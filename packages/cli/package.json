{
  "name": "@shipvo/cli",
  "version": "0.1.7",
  "type": "module",
  "license": "Apache-2.0",
  "shipvoCommands": [
    "init",
    "sim",
    "smoke",
    "run",
    "explore",
    "lumi",
    "preview",
    "publish",
    "promote",
    "auto-halt",
    "rollback",
    "app",
    "eas",
    "login",
    "doctor",
    "store",
    "ci",
    "status",
    "agents",
    "skills",
    "audit",
    "migrate",
    "approvals",
    "test",
    "keys",
    "mcp",
    "keygen",
    "pubkey",
    "hash",
    "sign-file",
    "sign-json",
    "verify-json",
    "verify"
  ],
  "bin": {
    "shipvo": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js && mkdir -p dist/templates && cp -R ../../templates/. dist/templates/",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@shipvo/schema": "workspace:*",
    "@shipvo/sim": "workspace:^",
    "@shipvo/store": "workspace:^",
    "plist": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/plist": "^3.0.5",
    "js-yaml": "4.3.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "description": "Shipvo CLI: create an app (init), run it in the simulator (sim), sign and publish over-the-air releases (publish, rollback), manage signing keys.",
  "keywords": [
    "react-native",
    "expo",
    "ota",
    "over-the-air-updates",
    "codepush",
    "codepush-alternative",
    "hot-updates",
