  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipvo/shipvo.git",
    "directory": "packages/cli"
  },
  "files": [
    "skills",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
