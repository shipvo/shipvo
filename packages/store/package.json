{
  "name": "@shipvo/store",
  "version": "0.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Work out what Google Play and the App Store will ask about your app: Data safety answers, a draft privacy policy and a list of questions only you can answer, derived from shipvo.json. Offline; nothing is uploaded.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "shipvo",
    "react-native",
    "google-play",
    "app-store",
    "data-safety",
    "privacy-policy",
    "store-listing"
  ],
  "homepage": "https://github.com/shipvo/shipvo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipvo/shipvo.git",
    "directory": "packages/store"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
