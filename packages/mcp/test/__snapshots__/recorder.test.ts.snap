// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MCP tools > lists the three tools with their schemas 1`] = `
[
  {
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "caption": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "caption",
      ],
      "type": "object",
    },
    "name": "record_marker",
  },
  {
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "background": {
          "description": "Behind the phone: "brand", "plain" (white) or a CSS colour such as "#102030"",
          "minLength": 1,
          "type": "string",
        },
        "format": {
          "description": "Video shape (default 9:16: 1080x1920; 16:9 is 1920x1080; 1:1 is 1080x1080)",
          "enum": [
            "9:16",
            "16:9",
            "1:1",
          ],
          "type": "string",
        },
        "fps": {
          "description": "Frames per second (default 30)",
          "enum": [
            30,
            60,
          ],
          "type": "number",
        },
        "lumi": {
          "description": "Include Lumi and its step captions in the video (default true for recordings; set false for a plain phone).",
          "type": "boolean",
        },
        "lumi_voice": {
          "description": "Lumi speaks its short step lines with the energetic voice preset (default false). Needs python3, ffmpeg and network access for the voice. Ignored when record_stop gets a narration file.",
          "type": "boolean",
        },
        "show_taps": {
          "description": "Draw a finger dot and ripple on taps and a trail on scrolls (default true)",
          "type": "boolean",
        },
        "title": {
          "description": "Used in the file name",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "record_start",
  },
  {
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "music": {
          "description": "Mix a music bed under the video (default false). Needs python3, ffmpeg and ffprobe; picks a track from Jamendo unless SHIPVO_MUSIC_FILE is set.",
          "type": "boolean",
        },
        "narration": {
          "description": "Path to a wav with a voice track. It is mixed over the video, trimmed to the video length (the result says so), and ducks the music when music is true.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "record_stop",
  },
]
`;
