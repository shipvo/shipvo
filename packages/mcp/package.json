{
  "name": "@shipvo/mcp",
  "version": "0.0.11",
  "type": "module",
  "license": "Apache-2.0",
  "description": "MCP server that lets AI agents open, see and operate Shipvo apps without a phone: a phone-sized simulator of the real app, plus the app's typed commands and owner API.",
  "bin": {
    "shipvo-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "exports": {
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/inline-tools.mjs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.8.0",
    "vitest": "^2.1.4",
    "playwright": "1.63.0",
    "@shipvo/mcp-tools": "workspace:*",
    "esbuild": "^0.21.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "react-native",
    "expo",
    "mobile-testing",
    "simulator",
    "shipvo"
  ],
  "homepage": "https://github.com/shipvo/shipvo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipvo/shipvo.git",
    "directory": "packages/mcp"
  },
  "files": [
    "skills",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.shipvo/shipvo",
  "peerDependencies": {
    "playwright": ">=1.50"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
