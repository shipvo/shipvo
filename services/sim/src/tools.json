[
 {
  "name": "list_apps",
  "description": "Apps this server can open, with what each one does. Optional query filters by name, description or category (e.g. 'shop', 'douala').",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "open_app",
  "description": "Open an app in a fresh phone-sized session and return its first screen.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "app": {
     "type": "string",
     "description": "App id from list_apps, optionally with a release: 'tide' (local build), 'tide@latest' or 'tide@r13' (the published release phones run)"
    },
    "session": {
     "type": "string",
     "description": "Session name (default: generated). One session is one phone."
    },
    "seed_cart": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "product_id": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "quantity": {
        "type": "integer",
        "exclusiveMinimum": 0
       },
       "qty": {
        "type": "integer",
        "exclusiveMinimum": 0
       }
      },
      "additionalProperties": false
     },
     "description": "Start with these items already in the cart (test shortcut). Each line: { product_id, quantity }; { id, qty } also works."
    },
    "dark": {
     "type": "boolean",
     "description": "Dark mode"
    }
   },
   "required": [
    "app"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "list_sessions",
  "description": "Open simulator sessions (phones) on this server: id, app, release and when each started. Use to resume after a reconnect.",
  "inputSchema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {}
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "screen",
  "description": "The current screen as an accessibility tree with refs.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "tap",
  "description": "Tap a button, link or choice by ref. Returns the new screen.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    },
    "ref": {
     "type": "string",
     "pattern": "^e\\d+$",
     "description": "Element ref from the screen, e.g. e42"
    }
   },
   "required": [
    "session",
    "ref"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "type",
  "description": "Type into a text field by ref (replaces its content). Returns the new screen.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    },
    "ref": {
     "type": "string",
     "pattern": "^e\\d+$",
     "description": "Element ref from the screen, e.g. e42"
    },
    "text": {
     "type": "string"
    },
    "enter": {
     "type": "boolean",
     "description": "Press Enter afterwards"
    }
   },
   "required": [
    "session",
    "ref",
    "text"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "scroll",
  "description": "Scroll the page (down/up) or a horizontal rail (right/left, give the rail's ref). Returns the new screen.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    },
    "direction": {
     "type": "string",
     "enum": [
      "down",
      "up",
      "left",
      "right"
     ]
    },
    "ref": {
     "type": "string",
     "pattern": "^e\\d+$",
     "description": "Scroll inside this element (a rail or list); omit for the page"
    }
   },
   "required": [
    "session",
    "direction"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "back",
  "description": "Go back one screen.",
  "inputSchema": {
   "type": "object",
