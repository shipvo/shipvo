 {
  "name": "set_device",
  "description": "Change what the simulated phone has: location, the address book (contacts), calendar events, files for the file picker, a barcode in front of the camera, permission states, whether the fingerprint will match, whether a payment will be approved, network on/off. Takes effect for the next action.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    },
    "location": {
     "type": "object",
     "properties": {
      "latitude": {
       "type": "number"
      },
      "longitude": {
       "type": "number"
      },
      "accuracy": {
       "type": "number"
      }
     },
     "required": [
      "latitude",
      "longitude"
     ],
     "additionalProperties": false
    },
    "camera": {
     "type": "object",
     "properties": {
      "barcode": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "type": {
           "type": "string"
          },
          "data": {
           "type": "string"
          }
         },
         "required": [
          "type",
          "data"
         ],
         "additionalProperties": false
        },
        {
         "type": "null"
        }
       ]
      },
      "delayMs": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    "permissions": {
     "type": "object",
     "properties": {
      "camera": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      },
      "location": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      },
      "notifications": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      },
      "contacts": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      },
      "calendar": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      }
     },
     "additionalProperties": false
    },
    "contacts": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "phoneNumbers": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "emails": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "id",
       "name"
      ],
      "additionalProperties": false
     },
     "description": "Replace the address book the app can read (needs contacts permission)"
    },
    "calendar": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "start": {
        "type": "string",
        "description": "ISO 8601"
       },
       "end": {
        "type": "string",
        "description": "ISO 8601"
       },
       "allDay": {
        "type": "boolean"
       },
       "location": {
        "type": "string"
       },
       "notes": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "start",
       "end"
      ],
      "additionalProperties": false
     },
     "description": "Replace the calendar events the app can read (needs calendar permission)"
    },
    "files": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "mimeType": {
        "type": "string"
       },
       "content": {
        "type": "string",
        "description": "The file's text"
       }
      },
      "required": [
       "name",
       "mimeType",
       "content"
      ],
      "additionalProperties": false
     },
     "description": "Replace the files the file picker offers"
    },
    "biometrics": {
     "type": "object",
     "properties": {
      "enrolled": {
       "type": "boolean"
      },
      "nextResult": {
       "type": "string",
       "enum": [
        "success",
        "fail",
        "cancel"
       ]
      }
     },
     "additionalProperties": false
    },
    "payment": {
     "type": "object",
     "properties": {
      "nextResult": {
       "type": "string",
       "enum": [
        "approve",
        "decline",
        "timeout",
        "insufficient_funds"
       ]
      },
      "pin": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "online": {
     "type": "boolean"
    },
    "wifi": {
     "type": "boolean"
    },
    "mobileData": {
     "type": "boolean"
    },
    "airplane": {
     "type": "boolean"
    },
    "locationServices": {
     "type": "boolean"
    },
    "darkMode": {
     "type": "boolean",
     "description": "The app's colour scheme (prefers-color-scheme)"
    },
    "dnd": {
     "type": "boolean",
     "description": "Do Not Disturb: notifications go to the shade without a banner"
    },
    "autoRotate": {
     "type": "boolean"
    },
    "flashlight": {
     "type": "boolean"
    },
    "orientationLock": {
     "type": "boolean"
    },
    "brightness": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "source": {
     "type": "string",
     "enum": [
      "auto",
      "simulated"
     ],
     "description": "\"simulated\" forces the simulated camera, microphone and location even when a person could grant the real ones, for reproducible runs"
    },
    "microphone": {
     "type": "object",
     "properties": {
      "level": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     },
     "additionalProperties": false
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
