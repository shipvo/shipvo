 {
  "name": "set_device",
  "description": "Change what the simulated phone has: location, a barcode in front of the camera, permission states, whether the fingerprint will match, whether a payment will be approved, network on/off. Takes effect for the next action.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    },
    "location": {
     "type": "object",
     "properties": {
      "latitude": {
       "type": "number"
      },
      "longitude": {
       "type": "number"
      },
      "accuracy": {
       "type": "number"
      }
     },
     "required": [
      "latitude",
      "longitude"
     ],
     "additionalProperties": false
    },
    "camera": {
     "type": "object",
     "properties": {
      "barcode": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "type": {
           "type": "string"
          },
          "data": {
           "type": "string"
          }
         },
         "required": [
          "type",
          "data"
         ],
         "additionalProperties": false
        },
        {
         "type": "null"
        }
       ]
      },
      "delayMs": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    "permissions": {
     "type": "object",
     "properties": {
      "camera": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      },
      "location": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      },
      "notifications": {
       "type": "string",
       "enum": [
        "granted",
        "denied",
        "undetermined"
       ]
      }
     },
     "additionalProperties": false
    },
    "biometrics": {
     "type": "object",
     "properties": {
      "enrolled": {
       "type": "boolean"
      },
      "nextResult": {
       "type": "string",
       "enum": [
        "success",
        "fail",
        "cancel"
       ]
      }
     },
     "additionalProperties": false
    },
    "payment": {
     "type": "object",
     "properties": {
      "nextResult": {
       "type": "string",
       "enum": [
        "approve",
        "decline",
        "timeout",
        "insufficient_funds"
       ]
      },
      "pin": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "online": {
     "type": "boolean"
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
