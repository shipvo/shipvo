 {
  "name": "device_reset",
  "description": "Put the simulated phone back to a known state (permissions undetermined, default location, nothing in front of the camera, log cleared), optionally with a new profile.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    },
    "platform": {
     "type": "string",
     "enum": [
      "android",
      "ios"
     ]
    },
    "api": {
     "type": "number"
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "end_session",
  "description": "Close the session and get a report: steps taken, and the orders the app sent to its backend during the session.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "session": {
     "type": "string",
     "description": "Session from open_app"
    }
   },
   "required": [
    "session"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "owner_describe",
  "description": "List the owner commands of an app (content, prices, offers, orders, publish). Needs PN_OWNER_TOKEN.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "app": {
     "type": "string"
    }
   },
   "required": [
    "app"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 },
 {
  "name": "owner_command",
  "description": "Run an owner command against the live app (changes are audited; `publish` makes them live on every phone within seconds).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "app": {
     "type": "string"
    },
    "command": {
     "type": "string"
    },
    "args": {
     "type": "object",
     "additionalProperties": {}
    }
   },
   "required": [
    "app",
    "command"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
 }
]
