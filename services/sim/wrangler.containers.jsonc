{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipvo-sim",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [{ "class_name": "SimContainer", "image": "./Dockerfile", "max_instances": 3, "instance_type": "standard" }],
  "durable_objects": { "bindings": [{ "class_name": "SimContainer", "name": "SIM" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SimContainer"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "purenative", "database_id": "292c3334-c9a8-4215-a947-6e47d4792a59" }],
  "vars": { "CONTROL": "https://purenative-control.purenative.workers.dev" },
  "observability": { "enabled": true }
}
